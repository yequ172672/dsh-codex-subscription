{
  "name": "dsh-llm-codex",
  "version": "0.2.1",
  "description": "DSH LLM 适配器插件:复用 Codex CLI 本地登录凭证(~/.codex/auth.json)在 DSH 中直接使用 ChatGPT 订阅模型",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.bundle.yml",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/serialize.mjs test/translate.mjs test/auth.mjs test/adapter.mjs test/models.mjs && node test/apply-contract.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:probe": "node test/version-probe.mjs",
    "test:roundtrip": "node test/roundtrip.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm",
    "adapter",
    "codex",
    "chatgpt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yequ172672/dsh-codex-subscription.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "eventsource-parser": "^3.1.1",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2"
  }
}
