{
  "name": "dsh-llm-codex",
  "version": "0.2.0",
  "description": "DSH LLM 适配器插件:复用 Codex CLI 本地登录凭证(~/.codex/auth.json)在 DSH 中直接使用 ChatGPT 订阅模型",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.bundle.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/index.mjs",
    "test:smoke": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm",
    "adapter",
    "codex",
    "chatgpt",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yequ172672/dsh-codex-subscription.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "eventsource-parser": "^3.1.1",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-timeout": ">=0.1.2-rc.1 <0.1.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1"
  }
}
